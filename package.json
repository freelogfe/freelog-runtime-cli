{
  "name": "freelog-runtime-cli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @freelog-cli/tools-lib2 build && pnpm --filter @freelog-cli/cli2 build",
    "dev": "pnpm --filter @freelog-cli/cli2 dev",
    "test": "pnpm --filter @freelog-cli/tools-lib2 build && pnpm --filter @freelog-cli/cli2 test",
    "typecheck": "pnpm --filter @freelog-cli/tools-lib2 build && pnpm --filter @freelog-cli/cli2 typecheck",
    "check:compat": "pnpm --filter @freelog-cli/cli2 check:compat",
    "pack:dry-run": "pnpm --filter @freelog-cli/cli2 pack:dry-run",
    "verify:schemas": "pnpm --filter @freelog-cli/cli2 verify:schemas",
    "verify:packaged-cli": "pnpm --filter @freelog-cli/cli2 verify:packaged-cli",
    "verify": "pnpm --filter @freelog-cli/tools-lib2 verify && pnpm --filter @freelog-cli/cli2 verify",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5"
  }
}
