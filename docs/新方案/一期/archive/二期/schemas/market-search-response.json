{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "freelog-cli/design/market-search-response.json",
  "title": "market search success data (design draft)",
  "description": "Design-level schema in 二期 docs only; implement under packages/cli/schemas/",
  "type": "object",
  "required": ["items", "total", "skip", "limit"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceId", "status"],
        "properties": {
          "resourceId": { "type": "string" },
          "resourceTitle": { "type": "string" },
          "status": { "const": 1 }
        }
      }
    },
    "total": { "type": "integer", "minimum": 0 },
    "skip": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1 }
  }
}
