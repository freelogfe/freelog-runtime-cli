{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freelog:cli:schema:batch-config:v1",
  "title": "Freelog CLI batch resource configuration",
  "type": "object",
  "required": ["items"],
  "properties": {
    "defaults": { "$ref": "#/$defs/defaults" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filePath"],
        "properties": {
          "filePath": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "resourceTitle": { "type": "string", "maxLength": 100 },
          "itemTitle": { "type": "string", "maxLength": 100 },
          "skip": { "type": "boolean" },
          "resourceTypeCode": { "type": "string" },
          "resourceTypeName": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "intro": { "type": "string", "maxLength": 200 },
          "coverImages": { "$ref": "#/$defs/stringList" },
          "tags": { "$ref": "#/$defs/tags" },
          "policies": { "$ref": "#/$defs/policiesInput" },
          "policyFile": { "type": "string" },
          "dependencies": { "type": "array" },
          "baseUpcastResources": { "type": "array" },
          "authExcludedItems": { "type": "array" },
          "batchSignContracts": { "type": "array" },
          "inputAttrs": { "type": "array" },
          "customPropertyDescriptors": { "type": "array" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "policy": {
      "type": "object",
      "required": ["policyName", "policyText"],
      "properties": {
        "policyName": { "type": "string", "minLength": 2, "maxLength": 20 },
        "policyText": { "type": "string", "minLength": 1 },
        "status": { "enum": [0, 1] }
      },
      "additionalProperties": false
    },
    "policiesInput": {
      "anyOf": [
        { "$ref": "#/$defs/policy" },
        { "type": "array", "items": { "$ref": "#/$defs/policy" } }
      ]
    },
    "defaults": {
      "type": "object",
      "properties": {
        "resourceTypeCode": { "type": "string" },
        "resourceTypeName": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "intro": { "type": "string", "maxLength": 200 },
        "coverImages": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/tags" },
        "policies": { "$ref": "#/$defs/policiesInput" },
        "policyFile": { "type": "string" },
        "dependencies": { "type": "array" },
        "baseUpcastResources": { "type": "array" },
        "authExcludedItems": { "type": "array" },
        "batchSignContracts": { "type": "array" },
        "inputAttrs": { "type": "array" },
        "customPropertyDescriptors": { "type": "array" }
      },
      "additionalProperties": false
    }
  }
}
