{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freelog:cli:schema:freelog-manifest:v1",
  "title": "Freelog CLI project manifest",
  "type": "object",
  "required": ["schemaVersion", "subject", "identity", "resource"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "subject": { "enum": ["resource", "collection"] },
    "identity": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["typeCode", "title"],
      "properties": {
        "typeCode": { "type": "string", "minLength": 1 },
        "typeName": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "intro": { "type": "string", "maxLength": 200 },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 20 }
        },
        "coverImages": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "version": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["version", "filePath"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "filePath": { "type": "string" },
            "artifactMode": { "enum": ["file", "directory-zip"] },
            "description": { "type": "string" },
            "videoCover": { "type": "string" },
            "runtimeVersion": { "enum": ["0.4", "0.5", null] },
            "dependencies": { "$ref": "#/$defs/dependencies" },
            "baseUpcastResources": { "$ref": "#/$defs/baseUpcastResources" },
            "authExcludedItems": { "$ref": "#/$defs/authExcludedItems" },
            "batchSignContracts": { "$ref": "#/$defs/batchSignContracts" },
            "inputAttrs": { "$ref": "#/$defs/inputAttrs" },
            "customPropertyDescriptors": { "$ref": "#/$defs/customPropertyDescriptors" },
            "reusePlatformFile": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "policies": { "$ref": "#/$defs/policies" },
    "collection": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "description": { "type": "string" },
            "display": { "type": "object", "additionalProperties": { "type": "string" } },
            "items": { "type": "array" },
            "collectRules": {},
            "rssFeedUrl": { "type": "string" },
            "dependencies": { "$ref": "#/$defs/dependencies" },
            "baseUpcastResources": { "$ref": "#/$defs/baseUpcastResources" },
            "authExcludedItems": { "$ref": "#/$defs/authExcludedItems" },
            "inputAttrs": { "$ref": "#/$defs/inputAttrs" },
            "customPropertyDescriptors": { "$ref": "#/$defs/customPropertyDescriptors" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceId"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "resourceName": { "type": "string" },
          "versionRange": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "baseUpcastResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceId"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "resourceName": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "authExcludedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceId", "excludedType", "excludedValue"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "excludedType": { "enum": ["contractId", "policyId"] },
          "excludedValue": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "batchSignContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceId", "policyIds"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1 },
          "policyIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "subjectType": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "inputAttrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] }
        },
        "additionalProperties": false
      }
    },
    "customPropertyDescriptors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "defaultValue": { "type": "string" },
          "remark": { "type": "string" },
          "candidateItems": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policyName", "policyText"],
        "properties": {
          "policyName": { "type": "string", "minLength": 2, "maxLength": 20 },
          "policyText": { "type": "string", "minLength": 1 },
          "status": { "enum": [0, 1] }
        },
        "additionalProperties": false
      }
    }
  }
}
