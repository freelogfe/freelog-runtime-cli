{
  "name": "@freelog-cli/cli2",
  "version": "0.5.8",
  "description": "Freelog CLI",
  "type": "module",
  "license": "MIT",
  "bin": {
    "freelog-cli": "./dist/bin/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node scripts/copy-usage-docs.mjs",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:dry-run": "pnpm build && npm pack --dry-run",
    "release:prepare": "node ../../scripts/release/cli.mjs prepare",
    "release:check": "node ../../scripts/release/cli.mjs check",
    "prepublishOnly": "node ../../scripts/release/reject-direct-publish.mjs",
    "release:publish": "node ../../scripts/release/cli.mjs publish"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "@napi-rs/keyring": "^2.0.0",
    "archiver": "^7.0.1",
    "commander": "^14.0.0",
    "semver": "^7.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@freelog-cli/tools-lib2": "workspace:^",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.15.30",
    "@types/semver": "^7.7.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
