{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Freelog Resource Version Configuration",
  "description": "Freelog 资源版本配置文件，用于创建资源版本",
  "type": "object",
  "required": ["version", "fileSha1", "filename"],
  "properties": {
    "version": {
      "type": "string",
      "description": "版本号（必填）",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": ["1.0.0", "2.1.3"]
    },
    "fileSha1": {
      "type": "string",
      "description": "当前版本对应的文件 SHA1 值（必填）",
      "pattern": "^[a-f0-9]{40}$",
      "examples": ["4a10ed3b6e45f8014b8240ad37f44cfc9c75e754"]
    },
    "filename": {
      "type": "string",
      "description": "当前版本对应的文件名或对象名（必填）",
      "minLength": 1,
      "examples": ["index.html", "resource.zip"]
    },
    "description": {
      "type": "string",
      "description": "版本描述信息（可选）",
      "examples": ["修复了若干 bug，增加了新功能"]
    },
    "dependencies": {
      "type": "array",
      "description": "版本依赖信息（可选）",
      "items": {
        "type": "object",
        "required": ["resourceId", "versionRange"],
        "properties": {
          "resourceId": {
            "type": "string",
            "description": "依赖的资源 ID"
          },
          "versionRange": {
            "type": "string",
            "description": "依赖的资源版本范围",
            "examples": ["^1.0.0", "~2.1.0", ">=1.0.0 <2.0.0"]
          }
        }
      },
      "default": []
    },
    "customPropertyDescriptors": {
      "type": "array",
      "description": "版本自定义属性定义（可选）",
      "items": {
        "type": "object",
        "required": ["key", "defaultValue", "type"],
        "properties": {
          "key": {
            "type": "string",
            "description": "自定义属性名称"
          },
          "defaultValue": {
            "type": "string",
            "description": "自定义属性对应的值"
          },
          "type": {
            "type": "string",
            "description": "属性类型",
            "enum": ["editableText", "readonlyText", "radio", "checkbox", "select"]
          },
          "candidateItems": {
            "type": "array",
            "description": "选项列表（单选、多选、下拉选择时需要提供）",
            "items": {
              "type": "string"
            }
          },
          "remark": {
            "type": "string",
            "description": "字段说明"
          }
        }
      },
      "default": []
    },
    "baseUpcastResources": {
      "type": "array",
      "description": "版本上抛信息（第一个版本需要传递此参数）",
      "items": {
        "type": "object",
        "required": ["resourceId"],
        "properties": {
          "resourceId": {
            "type": "string",
            "description": "上抛的资源 ID"
          }
        }
      },
      "default": []
    },
    "batchSignContracts": {
      "type": "array",
      "description": "如果需要在创建版本时签约，则需要传递此参数（可选）",
      "items": {
        "type": "object",
        "required": ["resourceId", "subjectType", "policyIds"],
        "properties": {
          "resourceId": {
            "type": "string",
            "description": "解决的资源 ID"
          },
          "subjectType": {
            "type": "integer",
            "description": "标的物类型"
          },
          "policyIds": {
            "type": "array",
            "description": "策略 ID 列表",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": []
    },
    "inputAttrs": {
      "type": "array",
      "description": "输入属性数组（可选）",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "description": "属性键"
          },
          "value": {
            "description": "属性值（任意类型）"
          }
        }
      },
      "default": []
    },
    "authExcludedItems": {
      "type": "array",
      "description": "当前版本的授权排除项（可选）",
      "items": {
        "type": "object",
        "required": ["resourceId", "excludedType", "excludedValue"],
        "properties": {
          "resourceId": {
            "type": "string",
            "description": "受影响的资源 ID"
          },
          "excludedType": {
            "type": "string",
            "description": "排除类型",
            "enum": ["contractId", "policyId"]
          },
          "excludedValue": {
            "type": "string",
            "description": "具体的排除值，例如合约 ID 或策略 ID"
          }
        }
      },
      "default": []
    }
  }
}

