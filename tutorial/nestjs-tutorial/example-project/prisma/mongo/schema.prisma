// Prisma Schema for MongoDB
// 用于存储日志、配置等非结构化数据

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/client-mongo"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_MONGO")
}

// 操作日志
model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    Int      @map("user_id")
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT 等
  resource  String   // user, order, product 等
  resourceId String? @map("resource_id")
  metadata  Json?    // 额外的元数据
  ip        String?
  userAgent String?  @map("user_agent")
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("activity_logs")
}

// 系统配置 (动态配置)
model SystemConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// 用户会话 (用于追踪登录状态)
model UserSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       Int      @map("user_id")
  token        String   @unique
  deviceInfo   Json?    @map("device_info")
  ip           String?
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// 通知消息
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    Int              @map("user_id")
  type      NotificationType
  title     String
  content   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  ORDER
  PROMOTION
  MESSAGE
}
